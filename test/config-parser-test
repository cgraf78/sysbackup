#!/bin/bash
set -eu

repoDir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd) || exit 1
T=$(mktemp -d) || exit 1
trap 'rm -rf -- "$T"' EXIT
fails=0
declare -a cfg_sections=()

# shellcheck disable=SC2329 # Invoked indirectly by check.
rejects_config() {
  ! cfg_parse "$1"
}

# This source file is owned by sysbackup. The test deliberately reads no
# installed configuration or credentials.
source "$repoDir/lib/sysbackup/config-parser"

check() {
  local name=$1
  shift
  if "$@"; then
    echo "PASS $name"
  else
    echo "FAIL $name"
    fails=$((fails + 1))
  fi
}

cat >"$T/config" <<'EOF'
; a comment
 [global] ; section comment
 INCLUDES = "/one path" "/two"
 EXCLUDES = "*.tmp" ; trailing comment

[repo0]
REPO = "sftp:user@host:/backup path"
INCLUDES = "/three"
EOF
cfg_parse "$T/config"
check "valid sections are recorded" test "${cfg_sections[*]}" = "global repo0"
cfg_apply global
check "quoted global paths stay separate" test "${INCLUDES[*]}" = "/one path /two"
check "global excludes are parsed" test "${EXCLUDES[*]}" = "*.tmp"
cfg_apply repo0
check "repository location stays intact" test "$REPO" = "sftp:user@host:/backup path"
check "repo paths override global paths" test "${INCLUDES[*]}" = "/three"

printf '%s\n' '[global]' 'INCLUDES="/etc"' '[global]' >"$T/config"
check "duplicate section is rejected" rejects_config "$T/config"

printf '%s\n' '[global]' 'INVALID-NAME="value"' >"$T/config"
check "invalid variable name is rejected" rejects_config "$T/config"

printf '%s\n' 'INCLUDES="/etc"' '[global]' >"$T/config"
check "assignment before a section is rejected" rejects_config "$T/config"

printf '%s\n' '[global]' 'INCLUDES="/etc"' >"$T/config"
cfg_parse "$T/config"
check "subsequent parse drops old sections" test "${cfg_sections[*]}" = global

if [ "$fails" -eq 0 ]; then echo "All tests passed"; else echo "$fails test(s) failed"; fi
exit "$((fails != 0))"
