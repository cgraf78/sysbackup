#!/bin/bash
# The copied recipe points only into /run, so these root installer tests cannot
# replace /usr/bin/sysbackup or live /etc/sysbackup configuration.
set -u

[ "$EUID" -eq 0 ] || {
  echo "Error: must run as root" >&2
  exit 1
}
repoDir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd) || exit 1
T=$(mktemp -d /run/sysbackup-install-test.XXXXXX) || exit 1
trap 'rm -rf -- "$T"' EXIT
cp "$repoDir/install" "$T/install"
printf 'new program\n' >"$T/program"
printf 'example secret\n' >"$T/environment"
fails=0

check() {
  local name=$1
  shift
  if "$@"; then echo "PASS $name"; else
    echo "FAIL $name"
    sed 's/^/    /' "$T/out"
    fails=$((fails + 1))
  fi
}

# The synthetic recipes below exercise installer behavior. Also verify the
# shipped recipe itself, since a moved template can otherwise go unnoticed.
while IFS=: read -r source_file _; do
  [ -n "$source_file" ] && [[ $source_file != \#* ]] || continue
  check "shipped source exists: $source_file" test -f "$repoDir/$source_file"
done <"$repoDir/install.recipe"

recipe() {
  printf '%s\n' "program:$T/bin:755" "environment:$T/etc:600:nooverwrite" >"$T/install.recipe"
}
run_install() { bash "$T/install" >"$T/out" 2>&1; }

recipe
(
  umask 000
  run_install
)
check "installs files with final ownership and mode" \
  test "$(stat -c '%u:%a' "$T/bin/program") $(stat -c '%u:%a' "$T/etc/environment")" = "0:755 0:600"
check "fresh destination directories stay root-owned and non-writable" \
  test "$(stat -c '%u:%a' "$T/bin") $(stat -c '%u:%a' "$T/etc")" = "0:755 0:755"

printf 'kept\n' >"$T/etc/environment"
run_install
check "nooverwrite preserves existing contents" test "$(cat "$T/etc/environment")" = kept

rm "$T/etc/environment"
printf 'victim\n' >"$T/victim"
ln -s "$T/victim" "$T/etc/environment"
run_install
rc=$?
check "rejects a destination symlink" test "$rc" -ne 0
check "does not modify the symlink target" test "$(cat "$T/victim")" = victim

rm "$T/etc/environment"
chmod 777 "$T/etc"
run_install
rc=$?
check "rejects a writable config directory" test "$rc" -ne 0
chmod 755 "$T/etc"

mkdir "$T/etc/environment"
run_install
rc=$?
check "rejects a destination directory" test "$rc" -ne 0

rm -rf "$T/etc/environment"
printf 'old program\n' >"$T/bin/program"
printf '%s\n' "program:$T/bin:755" "missing:$T/etc:600:nooverwrite" >"$T/install.recipe"
run_install
rc=$?
check "missing late source fails before install" test "$rc" -ne 0
check "missing late source leaves prior executable" test "$(cat "$T/bin/program")" = 'old program'

rm -rf "$T/etc/environment"
mkdir "$T/examples"
printf 'nested template\n' >"$T/examples/environment"
printf '%s\n' "examples/environment:$T/etc:600:nooverwrite" >"$T/install.recipe"
run_install
check "nested template installs under its basename" test "$(cat "$T/etc/environment")" = 'nested template'

if [ "$fails" -eq 0 ]; then echo "All tests passed"; else echo "$fails test(s) failed"; fi
exit "$((fails != 0))"
