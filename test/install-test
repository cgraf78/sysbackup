#!/bin/bash
# A fake account lookup confines standalone installation to a temporary home.
set -u

repoDir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd) || exit 1
T=$(mktemp -d) || exit 1
trap 'rm -rf -- "$T"' EXIT
mkdir -m 0700 "$T/home" "$T/bin"
cat >"$T/bin/getent" <<'GETENT'
#!/bin/bash
[[ $1 == passwd && $2 == "$TEST_UID" ]] || exit 1
printf 'fixture:x:%s:%s::%s:/bin/bash\n' "$TEST_UID" "$TEST_GID" "$TEST_HOME"
GETENT
chmod 755 "$T/bin/getent"
TEST_GID=$(id -g) || exit 1
export TEST_UID=$EUID TEST_GID TEST_HOME=$T/home
export PATH="$T/bin:$PATH"
fails=0

check() {
  local name=$1
  shift
  if "$@"; then echo "PASS $name"; else
    echo "FAIL $name"
    fails=$((fails + 1))
  fi
}

bash "$repoDir/install" >"$T/out" 2>&1
rc=$?
check 'standalone install succeeds' test "$rc" -eq 0
check 'command links to the checkout' test \
  "$(readlink "$T/home/.local/bin/sysbackup")" = "$repoDir/bin/sysbackup"
check 'config templates are private' test \
  "$(stat -c %a "$T/home/.config/sysbackup/sysbackup.conf") $(stat -c %a "$T/home/.config/sysbackup/sysbackup.env")" = '600 600'

printf 'local setting\n' >"$T/home/.config/sysbackup/sysbackup.conf"
bash "$repoDir/install" >"$T/out" 2>&1
check 'existing configuration is preserved' test \
  "$(cat "$T/home/.config/sysbackup/sysbackup.conf")" = 'local setting'

ln -s "$T/victim" "$T/home/.config/sysbackup/sysbackup.env.next"
mv "$T/home/.config/sysbackup/sysbackup.env" "$T/home/.config/sysbackup/sysbackup.env.saved"
mv "$T/home/.config/sysbackup/sysbackup.env.next" "$T/home/.config/sysbackup/sysbackup.env"
bash "$repoDir/install" >"$T/out" 2>&1
rc=$?
check 'symlinked credentials are refused' test "$rc" -ne 0
check 'symlink target is untouched' test ! -e "$T/victim"

rm -- "$T/home/.config/sysbackup/sysbackup.env"
mv "$T/home/.config/sysbackup/sysbackup.env.saved" \
  "$T/home/.config/sysbackup/sysbackup.env"
rm -- "$T/home/.local/bin/sysbackup"
printf 'locally owned command\n' >"$T/home/.local/bin/sysbackup"
bash "$repoDir/install" >"$T/out" 2>&1
rc=$?
check 'regular command is never replaced' test "$rc" -ne 0
check 'regular command contents are preserved' test \
  "$(cat "$T/home/.local/bin/sysbackup")" = 'locally owned command'

mkdir -m 0700 "$T/home-invalid"
mkdir -p "$T/home-invalid/.config/sysbackup"
ln -s "$T/victim" "$T/home-invalid/.config/sysbackup/sysbackup.env"
export TEST_HOME=$T/home-invalid
bash "$repoDir/install" >"$T/out" 2>&1
rc=$?
check 'late invalid env fails before linking' test "$rc" -ne 0
check 'late invalid env leaves no command or config' test \
  ! -e "$TEST_HOME/.local/bin/sysbackup"
check 'late invalid env leaves no new config' test \
  ! -e "$TEST_HOME/.config/sysbackup/sysbackup.conf"

mkdir -m 0700 "$T/home-missing"
mkdir -p "$T/incomplete/bin" "$T/incomplete/lib/sysbackup" "$T/incomplete/examples"
cp "$repoDir/install" "$T/incomplete/install"
cp "$repoDir/bin/sysbackup" "$T/incomplete/bin/sysbackup"
cp "$repoDir/lib/sysbackup/config-parser" "$T/incomplete/lib/sysbackup/config-parser"
cp "$repoDir/examples/sysbackup.conf" "$T/incomplete/examples/sysbackup.conf"
export TEST_HOME=$T/home-missing
bash "$T/incomplete/install" >"$T/out" 2>&1
rc=$?
check 'missing late template fails before linking' test "$rc" -ne 0
check 'missing late template leaves no command' test \
  ! -e "$TEST_HOME/.local/bin/sysbackup"
check 'missing late template leaves no config' test \
  ! -e "$TEST_HOME/.config/sysbackup/sysbackup.conf"

mkdir -m 0700 "$T/home-unsafe-template"
cp "$repoDir/examples/sysbackup.env" "$T/incomplete/examples/sysbackup.env"
chmod 0666 "$T/incomplete/examples/sysbackup.env"
export TEST_HOME=$T/home-unsafe-template
bash "$T/incomplete/install" >"$T/out" 2>&1
rc=$?
check 'writable credentials template is refused' test "$rc" -ne 0
check 'writable credentials template leaves no command' test \
  ! -e "$TEST_HOME/.local/bin/sysbackup"
check 'writable credentials template leaves no config' test \
  ! -e "$TEST_HOME/.config/sysbackup/sysbackup.conf"

printf '\nResults: %d failed\n' "$fails"
exit "$((fails != 0))"
